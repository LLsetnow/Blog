[Unit]
Description=Secure Blog Editor API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blog-editor
Group=blog-editor
WorkingDirectory=/opt/blog-editor-api
EnvironmentFile=/var/OPC/.env
ExecStart=/usr/bin/python3 /opt/blog-editor-api/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blog-editor

[Install]
WantedBy=multi-user.target
